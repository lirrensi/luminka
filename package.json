{
    "name": "luminka",
    "private": true,
    "type": "module",
    "version": "3.1.0",
    "description": "Browser-first Go runtime with an in-repo TypeScript SDK for desktop-style web apps.",
    "license": "MIT",
    "author": "lirrensi",
    "homepage": "https://github.com/lirrensi/luminka",
    "bugs": {
        "url": "https://github.com/lirrensi/luminka/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lirrensi/luminka.git"
    },
    "keywords": [
        "go",
        "runtime",
        "sdk",
        "websocket",
        "desktop",
        "webview"
    ],
    "scripts": {
        "build:sdk": "tsx scripts/build_sdk.ts",
        "build:icons": "tsx scripts/build_icons.ts",
        "build:starter": "starter\\build.bat",
        "build:starter:webview": "starter\\build_webview.bat",
        "build:examples": "npm run build:sdk",
        "build:all": "npm run build:sdk",
        "test:sdk": "tsx --test luminka/sdk/luminka.test.ts"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "@fiahfy/icns": "^0.0.7",
        "png-to-ico": "^3.0.1",
        "sharp": "^0.34.5",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2"
    }
}
